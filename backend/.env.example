# ===== App =====
APP_ENV=development
LOG_LEVEL=DEBUG
APP_NAME=thinkcanvas

# ===== Database (Postgres) =====
DATABASE_URL=postgresql+asyncpg://thinkcanvas:thinkcanvas@localhost:5432/thinkcanvas
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10

# ===== Redis =====
REDIS_URL=redis://localhost:6379/0
RQ_QUEUE_NAME=default

# ===== LLM (OpenAI-compatible: MiniMax / DeepSeek / 等) =====
# 填你自己的 key；.env 已被 .gitignore，不会被 commit
OPENAI_BASE_URL=https://api.minimaxi.com/v1
OPENAI_API_KEY=sk-your-key-here
OPENAI_MODEL=MiniMax-M3
LLM_TIMEOUT=120
LLM_MAX_TOKENS=4000
LLM_TEMPERATURE=0.2
LLM_MAX_RETRIES=2

# ===== Manim =====
MANIM_TIMEOUT=60
MANIM_MAX_CPU=1
MANIM_MAX_MEM=2048
MANIM_DEFAULT_QUALITY=m

# ===== Storage =====
STORAGE_BACKEND=local
STORAGE_LOCAL_PATH=./media

# ===== API =====
CORS_ORIGINS=http://localhost:3000
API_V1_PREFIX=/api/v1

# ===== Workflow =====
MAX_CODE_RETRIES=2
MAX_RENDER_RETRIES=1
TASK_TTL_SECONDS=86400
